<UserControl x:Class="MarvinsAIRARefactored.Pages.OverlaysPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[AllOverlays]}"
                                HelpTopic="advanced/overlays/#all-overlays">

            <StackPanel>

                <controls:MairaSwitch x:Name="MakeAllOverlaysDraggable_MairaSwitch"
                                      Label="{Binding Localization[MakeAllOverlaysVisibleAndDraggable]}"
                                      Toggled="MakeAllOverlaysDraggable_MairaSwitch_Toggled" />

                <controls:MairaSwitch x:Name="ShowWhenOffTrack_MairaSwitch"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowWhenOffTrack, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowWhenOffTrack]}" />

                <controls:MairaSwitch x:Name="ShowInReplayMode_MairaSwitch"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowInReplayMode, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowInReplayMode]}" />

                <controls:MairaSwitch x:Name="EnablePerCarPositionAndScaling_MairaSwitch"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysEnablePerCarPositionAndScaling, Mode=TwoWay}"
                                      Label="{Binding Localization[EnablePerCarOverlayPositionAndScaling]}" />

                <controls:MairaButton x:Name="ResetAllOverlays_MairaButton"
                                      Margin="0,20,0,0"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                      Label="{Binding Localization[ResetAllOverlayWindows]}"
                                      Click="ResetAllOverlays_MairaButton_Click" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="GapMonitor_MairaGroupBox"
                                Label="{Binding Localization.Upper[GapMonitor]}"
                                HelpTopic="advanced/overlays/#gap-monitor">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGapMonitorWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowGapMonitorTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="DeltaMonitor_MairaGroupBox"
                                Label="{Binding Localization.Upper[DeltaMonitor]}"
                                HelpTopic="advanced/overlays/#delta-monitor">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowDeltaMonitorWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowDeltaMonitorTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="GripOMeter_MairaGroupBox"
                                Label="{Binding Localization.Upper[GripOMeter]}"
                                HelpTopic="advanced/overlays/#grip-o-meter">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGripOMeterWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowGripOMeterTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="SpeechToText_MairaGroupBox"
                                Label="{Binding Localization.Upper[SpeechToText]}"
                                HelpTopic="advanced/overlays/#captions">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.SpeechToTextEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowSpeechToTextTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="Graph_MairaGroupBox"
                                Label="{Binding Localization.Upper[Graph]}"
                                HelpTopic="advanced/overlays/#graph">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGraphWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowGraphTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

                <Grid Margin="0,20,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaSwitch Grid.Row="0"
                                          Grid.Column="0"
                                          IsOn="{Binding Settings.GraphInputTorque, Mode=TwoWay}"
                                          Label="{Binding Localization[InputTorque]}" />

                    <controls:MairaSwitch Grid.Row="0"
                                          Grid.Column="2"
                                          IsOn="{Binding Settings.GraphOutputTorque, Mode=TwoWay}"
                                          Label="{Binding Localization[OutputTorque]}" />

                    <controls:MairaSwitch Grid.Row="2"
                                          Grid.Column="0"
                                          IsOn="{Binding Settings.GraphInputTorque60Hz, Mode=TwoWay}"
                                          Label="{Binding Localization[InputTorque60Hz]}" />

                    <controls:MairaSwitch Grid.Row="2"
                                          Grid.Column="2"
                                          IsOn="{Binding Settings.GraphInputLFE, Mode=TwoWay}"
                                          Label="{Binding Localization[InputLFE]}" />

                    <controls:MairaSwitch Grid.Row="4"
                                          Grid.Column="0"
                                          IsOn="{Binding Settings.GraphClutchPedalHaptics, Mode=TwoWay}"
                                          Label="{Binding Localization[ClutchPedalHaptics]}" />

                    <controls:MairaSwitch Grid.Row="4"
                                          Grid.Column="2"
                                          IsOn="{Binding Settings.GraphBrakePedalHaptics, Mode=TwoWay}"
                                          Label="{Binding Localization[BrakePedalHaptics]}" />

                    <controls:MairaSwitch Grid.Row="4"
                                          Grid.Column="4"
                                          IsOn="{Binding Settings.GraphThrottlePedalHaptics, Mode=TwoWay}"
                                          Label="{Binding Localization[ThrottlePedalHaptics]}" />

                    <controls:MairaSwitch Grid.Row="6"
                                          Grid.Column="0"
                                          IsOn="{Binding Settings.GraphTimerJitter, Mode=TwoWay}"
                                          Label="{Binding Localization[TimerJitter]}" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
